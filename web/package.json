{
  "name": "daydream-web",
  "private": true,
  "description": "Daydream's web UI. `npm run build` bundles it into crates/daydream-server/src, where the server embeds it.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "budget": "node budget.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "svelte-check": "4.7.8",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@lucide/svelte": "1.71.0",
    "bits-ui": "2.21.0",
    "svelte": "5.57.3"
  }
}
